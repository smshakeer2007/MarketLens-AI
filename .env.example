# MarketLens AI - Environment Configuration Template
# Copy this file to .env and configure your variables

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# API Configuration
PROJECT_NAME="MarketLens AI"
API_V1_PREFIX="/api/v1"

# SQLite Async Database URL
DATABASE_URL="sqlite+aiosqlite:///./marketlens.db"

# Data Caching TTL (seconds)
CACHE_TTL_SECONDS=300

# Benchmark Symbols
DEFAULT_BENCHMARK="SPY"
INDIAN_BENCHMARK="^NSEI"

# Optional LLM API Keys (API keys never hardcoded; leave blank for deterministic quantitative insight fallback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Frontend Configuration
VITE_API_URL="http://localhost:8000/api/v1"
